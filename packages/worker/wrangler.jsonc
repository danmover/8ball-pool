// Cloudflare Workers config. Everything here fits the free plan:
//  - static assets are free and unmetered,
//  - Durable Objects on the free plan must use the SQLite backend (new_sqlite_classes),
//  - the relay uses WebSocket hibernation, so an idle room costs nothing.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "8ball-pool",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "../client/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/ws/*", "/api/*", "/healthz"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "RoomRelay" },
      { "name": "DIRECTORY", "class_name": "Directory" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomRelay", "Directory"] }],
  "observability": { "enabled": true }
}
